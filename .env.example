# ============================================================
# AIOps Sentinel — Environment Variables
#
# Per spec: DB_PASSWORD and GEMINI_API_KEY are Docker secrets.
# Only non-sensitive configuration lives here.
#
# Copy to .env and fill in values:
#   cp .env.example .env
# ============================================================

# ------ Traefik / Domain -------------------------------------
SENTINEL_DOMAIN=sentinel.example.com

# ------ PostgreSQL (non-sensitive parts) ---------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
# POSTGRES_PASSWORD → ./secrets/postgres_password.txt  (Docker secret)

# ------ Gemini Models ----------------------------------------
GEMINI_FLASH_MODEL=gemini-3-flash-preview
GEMINI_PRO_MODEL=gemini-3-pro-preview
# GEMINI_API_KEY → ./secrets/gemini_api_key.txt  (Docker secret)

# ------ External Service URLs (container hostnames on dbnet) -
REDIS_URL=redis://redis:6379/0
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100

# ------ Monitoring Config ------------------------------------
PROMETHEUS_POLL_INTERVAL_SECONDS=30
PROMETHEUS_LOOKBACK_MINUTES=60
LOKI_LOG_LINES=100
LOKI_POLL_INTERVAL_SECONDS=5

# ------ MAD/CUSUM Thresholds ---------------------------------
MAD_ZSCORE_THRESHOLD=3.5
CUSUM_SLACK_MULTIPLIER=0.5
CUSUM_ALARM_THRESHOLD=4.0
LEARNING_WINDOW_DAYS=30

# ------ Gemini Thinking Budget (tokens) ----------------------
GEMINI_THINKING_BUDGET=15000
GEMINI_THINKING_BUDGET_MEDIUM=8000

# ------ Debug ------------------------------------------------
DEBUG=false

# ============================================================
# LOCAL DEVELOPMENT ONLY
# These values are overridden at runtime by Docker secrets
# (/run/secrets/gemini_api_key and /run/secrets/postgres_password).
# Uncomment and set only when running outside Docker.
# ============================================================
# POSTGRES_PASSWORD=local_dev_password_only
# GEMINI_API_KEY=local_dev_key_only
